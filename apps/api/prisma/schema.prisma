generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

model User {
  id                  String            @id @default(cuid())
  email               String            @unique
  name                String?
  passwordHash        String?
  lastName            String?
  city                String?
  province            String?
  country             String?
  authProvider        AuthProvider      @default(local)
  googleSub           String?           @unique
  status              UserStatus        @default(active)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  activeInstitutionId String?
  activeInstitution   Institution?      @relation(fields: [activeInstitutionId], references: [id])
  memberships         UserInstitution[]
  sessions            Session[]

  @@index([activeInstitutionId])
}

model Institution {
  id          String            @id @default(cuid())
  name        String
  plan        InstitutionPlan   @default(free)
  status      InstitutionStatus @default(active)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  exams       Exam[]
  signatures  ExamSignature[]
  questions   Question[]
  subjects    Subject[]
  topics      Topic[]
  activeUsers User[]
  memberships UserInstitution[]
}

model UserInstitution {
  id            String          @id @default(cuid())
  userId        String
  institutionId String
  role          InstitutionRole @default(admin)
  createdAt     DateTime        @default(now())
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, institutionId])
  @@index([institutionId, role])
  @@index([userId, role])
}

model Subject {
  id            String      @id @default(cuid())
  name          String
  institutionId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  questions     Question[]
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  topics        Topic[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

model Topic {
  id            String      @id @default(cuid())
  name          String
  subjectId     String
  institutionId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  questions     Question[]
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, name])
  @@index([institutionId])
  @@index([subjectId])
}

model Question {
  id            String             @id @default(cuid())
  institutionId String
  subjectId     String
  topicId       String
  type          QuestionType       @default(MULTIPLE_CHOICE)
  statement     String
  options       Json?
  correctIndex  Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  difficulty    QuestionDifficulty @default(medium)
  modelAnswer   String?
  examItems     ExamQuestion[]
  institution   Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subject       Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic         Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([subjectId])
  @@index([topicId])
}

model Exam {
  id            String         @id @default(cuid())
  institutionId String
  title         String
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  items         ExamQuestion[]
  signature     ExamSignature?

  @@index([institutionId])
}

model ExamQuestion {
  id         String   @id @default(cuid())
  examId     String
  questionId String
  order      Int
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
  @@index([examId])
  @@index([questionId])
}

model ExamSignature {
  id            String   @id @default(cuid())
  institutionId String
  signature     String
  createdAt     DateTime @default(now())
  examId        String   @unique
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, signature], name: "institutionId_signature")
  @@index([institutionId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  revokedAt DateTime?
  expiresAt DateTime

  @@index([userId])
}

enum AuthProvider {
  local
  google
}

enum UserStatus {
  active
  suspended
}

enum InstitutionPlan {
  free
  premium
}

enum InstitutionStatus {
  active
  inactive
}

enum InstitutionRole {
  admin
  professor
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  OPEN
}

enum QuestionDifficulty {
  easy
  medium
  hard
}
