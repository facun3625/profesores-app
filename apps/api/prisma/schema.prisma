generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

model User {
  id                  String            @id @default(cuid())
  email               String            @unique
  name                String?
  passwordHash        String?
  lastName            String?
  city                String?
  province            String?
  country             String?
  mustChangePassword  Boolean           @default(false)
  authProvider        AuthProvider      @default(local)
  googleSub           String?           @unique
  status              UserStatus        @default(active)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  activeInstitutionId String?
  activeInstitution   Institution?      @relation(fields: [activeInstitutionId], references: [id])
  memberships         UserInstitution[]
  subjectAccess       UserSubject[]
  sessions            Session[]
  createdQuestions    Question[]        @relation("QuestionAuthor")
  createdExams        Exam[]            @relation("ExamAuthor")
  activityLogs        ActivityLog[]

  @@index([activeInstitutionId])
}

model Institution {
  id            String            @id @default(cuid())
  name          String
  plan          InstitutionPlan   @default(free)
  status        InstitutionStatus @default(active)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  exams         Exam[]
  signatures    ExamSignature[]
  questions     Question[]
  subjects      Subject[]
  topics        Topic[]
  activeUsers   User[]
  memberships   UserInstitution[]
  subjectAccess UserSubject[]
}

model UserInstitution {
  id            String          @id @default(cuid())
  userId        String
  institutionId String
  role          InstitutionRole @default(admin)
  createdAt     DateTime        @default(now())
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, institutionId])
  @@index([institutionId, role])
  @@index([userId, role])
}

model Subject {
  id            String      @id @default(cuid())
  name          String
  institutionId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  questions     Question[]
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  topics        Topic[]
  userAccess    UserSubject[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

model Topic {
  id            String      @id @default(cuid())
  name          String
  subjectId     String
  institutionId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  questions     Question[]
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, name])
  @@index([institutionId])
  @@index([subjectId])
}

model Question {
  id                     String             @id @default(cuid())
  institutionId          String
  subjectId              String
  topicId                String
  createdById            String?
  type                   QuestionType       @default(MULTIPLE_CHOICE)
  statement              String
  options                Json?
  correctIndex           Int?
  openLines              Int?
  requiresJustification  Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  difficulty             QuestionDifficulty @default(medium)
  modelAnswer            String?
  examItems              ExamQuestion[]
  institution            Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subject                Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic                  Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdBy              User?              @relation("QuestionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([subjectId])
  @@index([topicId])
  @@index([createdById])
}

model Exam {
  id            String         @id @default(cuid())
  institutionId String
  createdById   String?
  title         String
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdBy     User?          @relation("ExamAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  items         ExamQuestion[]
  signature     ExamSignature?

  @@index([institutionId])
  @@index([createdById])
}

model ExamQuestion {
  id         String   @id @default(cuid())
  examId     String
  questionId String
  order      Int
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
  @@index([examId])
  @@index([questionId])
}

model ExamSignature {
  id            String   @id @default(cuid())
  institutionId String
  signature     String
  createdAt     DateTime @default(now())
  examId        String   @unique
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, signature], name: "institutionId_signature")
  @@index([institutionId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  revokedAt DateTime?
  expiresAt DateTime

  @@index([userId])
}

model UserSubject {
  id            String      @id @default(cuid())
  userId        String
  subjectId     String
  institutionId String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@index([userId])
  @@index([subjectId])
  @@index([institutionId])
}

model ActivityLog {
  id        String      @id @default(cuid())
  actorId   String
  action    LogAction
  entity    String
  entityId  String
  detail    Json?
  createdAt DateTime    @default(now())
  actor     User        @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([entityId])
  @@index([createdAt])
}

enum AuthProvider {
  local
  google
}

enum UserStatus {
  active
  suspended
}

enum InstitutionPlan {
  free
  premium
}

enum InstitutionStatus {
  active
  inactive
}

enum InstitutionRole {
  admin
  professor
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  OPEN
  FILL_IN
}

enum QuestionDifficulty {
  easy
  medium
  hard
}
